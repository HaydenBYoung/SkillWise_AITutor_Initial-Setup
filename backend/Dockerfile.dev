# Development Dockerfile for Backend
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install dependencies for native modules and OpenSSL
RUN apk add --no-cache python3 make g++ openssl-dev && \
    ln -s /usr/lib/libssl.so.3 /usr/lib/libssl.so.1.1 && \
    ln -s /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.1.1

# Copy package files
COPY package*.json ./

# Copy Prisma schema first (before npm install)
COPY prisma ./prisma

# Install dependencies including dev dependencies
# This will run prisma generate as a postinstall hook
RUN npm install

# Copy source code
COPY . .

# Create logs directory
RUN mkdir -p logs

# Expose port
EXPOSE 3001

# Start development server with hot reload
CMD ["npm", "run", "dev"]